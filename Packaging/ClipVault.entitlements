<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      ClipVault needs no special entitlements: it reads the general pasteboard and writes to
      its own Application Support directory — neither requires a grant, and it is intentionally
      NOT sandboxed (a clipboard manager must read the system pasteboard and manage a
      LaunchAgent). This empty entitlements set is signed under the hardened runtime so the app
      is notarizable; add keys only if a real capability is introduced.
    -->
</dict>
</plist>
